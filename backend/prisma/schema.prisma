generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StockMovementType {
  purchase
  sale
  adjustment
  return
  transfer
  waste
}

enum PurchaseStatus {
  draft
  received
  partial
  cancelled
}

enum PurchasePaymentStatus {
  unpaid
  partial
  paid
}

enum SupplierPaymentMethod {
  cash
  mobile_money
  bank
  cheque
  other
}

enum DebtStatus {
  open
  partial
  paid
  written_off
}

enum CustomerPaymentMethod {
  cash
  mobile_money
  bank
  cheque
  other
}

enum SaleStatus {
  completed
  held
  cancelled
  refunded
}

enum SalePaymentStatus {
  paid
  partial
  credit
}

enum SalePaymentMethod {
  cash
  mobile_money
  card
  bank
  other
  credit
  mixed
}

enum PaymentMethodWithOther {
  cash
  mobile_money
  card
  bank
  credit
  other
}

enum ExpensePaymentMethod {
  cash
  mobile_money
  bank
  other
}

enum CashSessionStatus {
  open
  closed
}

enum CashMovementType {
  sale
  purchase_payment
  expense
  customer_payment
  supplier_payment
  cash_in
  cash_out
  adjustment
  refund
  cash_drop
  cash_withdrawal
  cash_deposit
  cash_adjustment_in
  cash_adjustment_out
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id            Int       @id @default(autoincrement())
  role_id       Int
  full_name     String    @db.VarChar(120)
  username      String    @unique @db.VarChar(60)
  email         String?   @unique @db.VarChar(120)
  phone         String?   @db.VarChar(20)
  password_hash String    @db.VarChar(255)
  is_active     Int       @default(1) @db.TinyInt
  last_login    DateTime? @db.Timestamp(0)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(0)
}

model businesses {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(150)
  address    String?  @db.Text
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(120)
  tin        String?  @db.VarChar(50)
  currency   String?  @default("RWF") @db.VarChar(5)
  logo_url   String?  @db.VarChar(255)
  timezone   String   @default("Africa/Kigali") @db.VarChar(60)
  receipt_footer String? @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model system_settings {
  key        String   @id @db.VarChar(80)
  value      Json
  updated_by Int?
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model suppliers {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(150)
  contact_person String?  @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(120)
  address        String?  @db.Text
  notes          String?  @db.Text
  is_active      Int      @default(1) @db.TinyInt
  created_at     DateTime @default(now()) @db.Timestamp(0)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model categories {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
}

model units {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(50)
  abbreviation String?  @db.VarChar(10)
  created_at   DateTime @default(now()) @db.Timestamp(0)
}

model unit_conversions {
  id           Int     @id @default(autoincrement())
  from_unit_id Int
  to_unit_id   Int
  factor       Decimal @db.Decimal(12, 4)

  @@unique([from_unit_id, to_unit_id], map: "unique_conversion")
}

model products {
  id               Int      @id @default(autoincrement())
  category_id      Int?
  name             String   @db.VarChar(150)
  sku              String?  @unique @db.VarChar(50)
  barcode          String?  @db.VarChar(50)
  description      String?  @db.Text
  base_unit_id     Int
  purchase_unit_id Int?
  sale_unit_id     Int?
  cost_price       Decimal? @default(0) @db.Decimal(12, 2)
  selling_price    Decimal? @default(0) @db.Decimal(12, 2)
  min_stock_level  Decimal? @default(0) @db.Decimal(12, 3)
  is_active        Int?     @default(1) @db.TinyInt
  track_stock      Int?     @default(1) @db.TinyInt
  track_expiry     Int      @default(0) @db.TinyInt
  require_batch    Int      @default(0) @db.TinyInt
  image_url        String?  @db.VarChar(255)
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model product_units {
  id                 Int      @id @default(autoincrement())
  product_id         Int
  unit_id            Int
  conversion_factor  Decimal  @db.Decimal(14, 4)
  purchase_price     Decimal? @db.Decimal(14, 2)
  selling_price      Decimal? @db.Decimal(14, 2)
  is_purchase_enabled Int     @default(0) @db.TinyInt
  is_sale_enabled     Int     @default(0) @db.TinyInt
  is_active           Int     @default(1) @db.TinyInt
  is_default_purchase Int     @default(0) @db.TinyInt
  is_default_sale     Int     @default(0) @db.TinyInt
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([product_id, unit_id], map: "unique_product_unit")
  @@index([product_id, is_active], map: "idx_product_unit_active")
}

model product_unit_history {
  id         BigInt   @id @default(autoincrement())
  product_id Int
  unit_id    Int
  old_values Json?
  new_values Json
  reason     String   @db.Text
  changed_by Int?
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([product_id, created_at], map: "idx_product_unit_history_date")
}

model stock {
  id                Int      @id @default(autoincrement())
  product_id        Int      @unique
  quantity          Decimal  @default(0) @db.Decimal(14, 3)
  reserved_quantity Decimal? @default(0) @db.Decimal(14, 3)
  last_updated      DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model stock_movements {
  id             BigInt            @id @default(autoincrement())
  product_id     Int
  movement_type  StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  reference_type String?           @db.VarChar(50)
  reference_id   BigInt?
  unit_cost      Decimal?          @db.Decimal(12, 2)
  notes          String?           @db.Text
  adjustment_reason String?         @db.VarChar(50)
  previous_quantity Decimal?        @db.Decimal(14, 3)
  new_quantity   Decimal?           @db.Decimal(14, 3)
  approved_by    Int?
  approved_at    DateTime?          @db.Timestamp(0)
  created_by     Int?
  created_at     DateTime          @default(now()) @db.Timestamp(0)

  @@index([product_id, created_at], map: "idx_product_date")
  @@index([reference_type, reference_id], map: "idx_reference")
}

model purchases {
  id              BigInt                 @id @default(autoincrement())
  supplier_id     Int?
  invoice_number  String?                @db.VarChar(80)
  purchase_date   DateTime               @db.Date
  status          PurchaseStatus?        @default(received)
  subtotal        Decimal?               @default(0) @db.Decimal(14, 2)
  tax_amount      Decimal?               @default(0) @db.Decimal(14, 2)
  discount_amount Decimal?               @default(0) @db.Decimal(14, 2)
  total_amount    Decimal?               @default(0) @db.Decimal(14, 2)
  amount_paid     Decimal?               @default(0) @db.Decimal(14, 2)
  balance         Decimal?               @default(0) @db.Decimal(14, 2)
  payment_status  PurchasePaymentStatus? @default(unpaid)
  notes           String?                @db.Text
  created_by      Int?
  created_at      DateTime               @default(now()) @db.Timestamp(0)
  updated_at      DateTime               @default(now()) @updatedAt @db.Timestamp(0)
}

model purchase_items {
  id                       BigInt   @id @default(autoincrement())
  purchase_id              BigInt
  product_id               Int
  product_name_snapshot    String?  @db.VarChar(150)
  quantity                 Decimal  @db.Decimal(12, 3)
  unit_id                  Int
  unit_name_snapshot       String?  @db.VarChar(50)
  conversion_factor_snapshot Decimal? @db.Decimal(14, 4)
  quantity_base            Decimal  @db.Decimal(14, 3)
  unit_cost                Decimal  @db.Decimal(12, 2)
  total_cost               Decimal  @db.Decimal(14, 2)
}

model purchase_orders {
  id            BigInt   @id @default(autoincrement())
  order_number  String   @unique @db.VarChar(40)
  supplier_id   Int
  status        String   @default("draft") @db.VarChar(30)
  expected_date DateTime? @db.Date
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  total_amount  Decimal  @default(0) @db.Decimal(14, 2)
  notes         String?  @db.Text
  cancel_reason String?  @db.Text
  created_by    Int?
  approved_by   Int?
  cancelled_by  Int?
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@index([supplier_id, status], map: "idx_purchase_order_supplier_status")
}

model purchase_order_items {
  id                    BigInt  @id @default(autoincrement())
  purchase_order_id     BigInt
  product_id            Int
  product_name_snapshot String  @db.VarChar(150)
  quantity              Decimal @db.Decimal(12, 3)
  quantity_received_base Decimal @default(0) @db.Decimal(14, 3)
  unit_id               Int
  unit_name_snapshot    String  @db.VarChar(50)
  conversion_factor_snapshot Decimal @db.Decimal(14, 4)
  expected_unit_cost    Decimal @db.Decimal(12, 2)
  total_cost            Decimal @db.Decimal(14, 2)

  @@index([purchase_order_id], map: "idx_purchase_order_item_order")
}

model goods_receipts {
  id               BigInt   @id @default(autoincrement())
  receipt_number   String   @unique @db.VarChar(40)
  purchase_order_id BigInt
  purchase_id      BigInt?
  supplier_id      Int
  invoice_reference String? @db.VarChar(100)
  delivery_note    String?  @db.VarChar(100)
  received_at      DateTime @default(now()) @db.Timestamp(0)
  notes            String?  @db.Text
  received_by      Int?
  created_at       DateTime @default(now()) @db.Timestamp(0)

  @@index([purchase_order_id, received_at], map: "idx_receipt_order_date")
}

model goods_receipt_items {
  id                    BigInt   @id @default(autoincrement())
  receipt_id            BigInt
  purchase_order_item_id BigInt
  product_id            Int
  accepted_quantity     Decimal  @db.Decimal(12, 3)
  damaged_quantity      Decimal  @default(0) @db.Decimal(12, 3)
  missing_quantity     Decimal  @default(0) @db.Decimal(12, 3)
  unit_id               Int
  conversion_factor_snapshot Decimal @db.Decimal(14, 4)
  accepted_quantity_base Decimal @db.Decimal(14, 3)
  unit_cost             Decimal  @db.Decimal(12, 2)
  batch_number          String?  @db.VarChar(80)
  manufactured_at       DateTime? @db.Date
  expires_at            DateTime? @db.Date

  @@index([receipt_id], map: "idx_receipt_item_receipt")
  @@index([purchase_order_item_id], map: "idx_receipt_item_order_item")
}

model supplier_payments {
  id             BigInt                 @id @default(autoincrement())
  supplier_id    Int
  purchase_id    BigInt?
  amount         Decimal                @db.Decimal(14, 2)
  payment_method SupplierPaymentMethod? @default(cash)
  payment_date   DateTime               @db.Date
  reference      String?                @db.VarChar(100)
  notes          String?                @db.Text
  created_by     Int?
  created_at     DateTime               @default(now()) @db.Timestamp(0)
}

model supplier_payment_allocations {
  id                 BigInt  @id @default(autoincrement())
  supplier_payment_id BigInt
  purchase_id        BigInt
  amount             Decimal @db.Decimal(14, 2)
  created_at         DateTime @default(now()) @db.Timestamp(0)

  @@unique([supplier_payment_id, purchase_id], map: "unique_supplier_payment_invoice")
  @@index([purchase_id], map: "idx_supplier_allocation_purchase")
}

model supplier_returns {
  id             BigInt   @id @default(autoincrement())
  credit_note    String   @unique @db.VarChar(40)
  supplier_id    Int
  purchase_id    BigInt?
  receipt_id     BigInt?
  reason         String   @db.VarChar(100)
  settlement_type String  @default("credit") @db.VarChar(20)
  amount         Decimal  @db.Decimal(14, 2)
  notes          String?  @db.Text
  created_by     Int?
  created_at     DateTime @default(now()) @db.Timestamp(0)

  @@index([supplier_id, created_at], map: "idx_supplier_return_date")
}

model supplier_return_items {
  id                    BigInt  @id @default(autoincrement())
  supplier_return_id    BigInt
  purchase_item_id      BigInt
  product_id            Int
  product_name_snapshot String  @db.VarChar(150)
  quantity              Decimal @db.Decimal(12, 3)
  unit_id               Int
  unit_name_snapshot    String  @db.VarChar(50)
  conversion_factor_snapshot Decimal @db.Decimal(14, 4)
  quantity_base         Decimal @db.Decimal(14, 3)
  unit_cost             Decimal @db.Decimal(12, 2)
  total_cost            Decimal @db.Decimal(14, 2)

  @@index([supplier_return_id], map: "idx_supplier_return_item_return")
  @@index([purchase_item_id], map: "idx_supplier_return_item_purchase")
}

model stock_batches {
  id                 BigInt   @id @default(autoincrement())
  product_id         Int
  supplier_id        Int?
  receipt_id         BigInt?
  receipt_item_id    BigInt?
  batch_number       String?  @db.VarChar(80)
  received_quantity  Decimal  @db.Decimal(14, 3)
  remaining_quantity Decimal  @db.Decimal(14, 3)
  manufactured_at    DateTime? @db.Date
  expires_at         DateTime? @db.Date
  unit_cost_base     Decimal  @db.Decimal(12, 2)
  created_at         DateTime @default(now()) @db.Timestamp(0)

  @@index([product_id, expires_at], map: "idx_stock_batch_expiry")
}

model stock_count_sessions {
  id           BigInt   @id @default(autoincrement())
  count_number String   @unique @db.VarChar(40)
  status       String   @default("draft") @db.VarChar(20)
  category_id  Int?
  notes        String?  @db.Text
  submitted_by Int?
  submitted_at DateTime? @db.Timestamp(0)
  reviewed_by  Int?
  reviewed_at  DateTime? @db.Timestamp(0)
  review_notes String?  @db.Text
  created_by   Int?
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model stock_count_items {
  id                 BigInt  @id @default(autoincrement())
  count_session_id   BigInt
  product_id         Int
  product_name_snapshot String @db.VarChar(150)
  expected_quantity  Decimal @db.Decimal(14, 3)
  physical_quantity  Decimal? @db.Decimal(14, 3)
  variance           Decimal? @db.Decimal(14, 3)
  reason             String? @db.VarChar(50)
  notes              String? @db.Text

  @@unique([count_session_id, product_id], map: "unique_stock_count_product")
}

model bar_areas {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  sort_order Int      @default(0)
  is_active  Int      @default(1) @db.TinyInt
  created_by Int?
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([name], map: "unique_bar_area_name")
}

model dining_tables {
  id          Int      @id @default(autoincrement())
  area_id     Int
  table_name  String   @db.VarChar(50)
  capacity    Int      @default(2)
  sort_order  Int      @default(0)
  display_x   Int?
  display_y   Int?
  description String?  @db.Text
  is_active   Int      @default(1) @db.TinyInt
  created_by  Int?
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([area_id, table_name], map: "unique_table_name_per_area")
  @@index([area_id, is_active], map: "idx_table_area_active")
}

model table_sessions {
  id                    BigInt   @id @default(autoincrement())
  session_number        String   @unique @db.VarChar(40)
  dining_table_id       Int
  waiter_id             Int?
  guest_count           Int?
  status                String   @default("open") @db.VarChar(20)
  opened_by             Int?
  opened_at             DateTime @default(now()) @db.Timestamp(0)
  closed_by             Int?
  closed_at             DateTime? @db.Timestamp(0)
  merged_into_session_id BigInt?
  notes                 String?  @db.Text

  @@index([dining_table_id, status], map: "idx_table_session_status")
}

model table_session_events {
  id                    BigInt   @id @default(autoincrement())
  session_id            BigInt
  event_type            String   @db.VarChar(30)
  from_table_id         Int?
  to_table_id           Int?
  from_waiter_id        Int?
  to_waiter_id          Int?
  related_session_id    BigInt?
  reason                String?  @db.Text
  created_by            Int?
  created_at            DateTime @default(now()) @db.Timestamp(0)

  @@index([session_id, created_at], map: "idx_table_event_session_date")
}

model table_order_rounds {
  id          BigInt   @id @default(autoincrement())
  session_id  BigInt
  round_number Int
  status      String   @default("draft") @db.VarChar(20)
  notes       String?  @db.Text
  created_by  Int?
  served_by   Int?
  served_at   DateTime? @db.Timestamp(0)
  voided_by   Int?
  void_reason String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([session_id, round_number], map: "unique_session_round")
  @@index([session_id, status], map: "idx_table_round_status")
}

model table_order_items {
  id                       BigInt   @id @default(autoincrement())
  round_id                 BigInt
  product_id               Int
  product_name_snapshot    String   @db.VarChar(150)
  quantity                 Decimal  @db.Decimal(12, 3)
  unit_id                  Int
  unit_name_snapshot       String   @db.VarChar(50)
  conversion_factor_snapshot Decimal @db.Decimal(14, 4)
  quantity_base            Decimal  @db.Decimal(14, 3)
  unit_price               Decimal  @db.Decimal(12, 2)
  discount                 Decimal  @default(0) @db.Decimal(12, 2)
  line_total               Decimal  @db.Decimal(14, 2)
  cost_at_order            Decimal? @db.Decimal(12, 2)
  created_at               DateTime @default(now()) @db.Timestamp(0)

  @@index([round_id], map: "idx_table_order_item_round")
}

model table_payments {
  id             BigInt   @id @default(autoincrement())
  session_id     BigInt
  amount         Decimal  @db.Decimal(14, 2)
  payment_method String   @db.VarChar(30)
  status         String   @default("confirmed") @db.VarChar(20)
  reference      String?  @db.VarChar(100)
  external_reference String? @db.VarChar(100)
  idempotency_key String? @unique @db.VarChar(100)
  notes          String?  @db.Text
  received_by    Int?
  confirmed_by   Int?
  paid_at        DateTime @default(now()) @db.Timestamp(0)
  confirmed_at   DateTime? @db.Timestamp(0)

  @@index([session_id, paid_at], map: "idx_table_payment_session_date")
}

model table_serve_requests {
  id             BigInt   @id @default(autoincrement())
  session_id     BigInt
  round_id       BigInt
  idempotency_key String  @unique @db.VarChar(100)
  result         Json
  created_by     Int?
  created_at     DateTime @default(now()) @db.Timestamp(0)
}

model customers {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(120)
  address      String?  @db.Text
  credit_limit Decimal? @default(0) @db.Decimal(14, 2)
  notes        String?  @db.Text
  is_active    Int?     @default(1) @db.TinyInt
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model customer_debts {
  id               BigInt      @id @default(autoincrement())
  customer_id      Int
  sale_id          BigInt?
  original_amount  Decimal     @db.Decimal(14, 2)
  remaining_amount Decimal     @db.Decimal(14, 2)
  status           DebtStatus? @default(open)
  due_date         DateTime?   @db.Date
  notes            String?     @db.Text
  created_at       DateTime    @default(now()) @db.Timestamp(0)
  updated_at       DateTime    @default(now()) @updatedAt @db.Timestamp(0)
}

model customer_payments {
  id             BigInt                 @id @default(autoincrement())
  customer_id    Int
  debt_id        BigInt?
  amount         Decimal                @db.Decimal(14, 2)
  payment_method CustomerPaymentMethod? @default(cash)
  status         String                 @default("confirmed") @db.VarChar(20)
  payment_date   DateTime               @db.Date
  reference      String?                @db.VarChar(100)
  external_reference String?             @db.VarChar(100)
  idempotency_key String?                @unique @db.VarChar(100)
  notes          String?                @db.Text
  created_by     Int?
  confirmed_by   Int?
  created_at     DateTime               @default(now()) @db.Timestamp(0)
  confirmed_at   DateTime?              @db.Timestamp(0)
}

model customer_payment_allocations {
  id                 BigInt  @id @default(autoincrement())
  customer_payment_id BigInt
  debt_id            BigInt
  amount             Decimal @db.Decimal(14, 2)
  created_at         DateTime @default(now()) @db.Timestamp(0)

  @@unique([customer_payment_id, debt_id], map: "unique_customer_payment_debt")
  @@index([debt_id], map: "idx_customer_payment_allocation_debt")
}

model sales {
  id              BigInt             @id @default(autoincrement())
  receipt_number  String             @unique @db.VarChar(30)
  idempotency_key String?            @unique @db.VarChar(100)
  request_hash    String?            @db.Char(64)
  customer_id     Int?
  sale_date       DateTime           @default(now()) @db.DateTime(0)
  status          SaleStatus?        @default(completed)
  subtotal        Decimal?           @default(0) @db.Decimal(14, 2)
  tax_amount      Decimal?           @default(0) @db.Decimal(14, 2)
  discount_amount Decimal?           @default(0) @db.Decimal(14, 2)
  total_amount    Decimal?           @default(0) @db.Decimal(14, 2)
  amount_paid     Decimal?           @default(0) @db.Decimal(14, 2)
  change_given    Decimal?           @default(0) @db.Decimal(14, 2)
  payment_method  SalePaymentMethod? @default(cash)
  payment_status  SalePaymentStatus? @default(paid)
  notes           String?            @db.Text
  created_by      Int?
  created_at      DateTime           @default(now()) @db.Timestamp(0)
  updated_at      DateTime           @default(now()) @updatedAt @db.Timestamp(0)

  @@index([sale_date], map: "idx_sale_date")
  @@index([receipt_number], map: "idx_receipt")
}

model sale_items {
  id                       BigInt   @id @default(autoincrement())
  sale_id                  BigInt
  product_id               Int
  product_name_snapshot    String?  @db.VarChar(150)
  quantity                 Decimal  @db.Decimal(12, 3)
  unit_id                  Int
  unit_name_snapshot       String?  @db.VarChar(50)
  conversion_factor_snapshot Decimal? @db.Decimal(14, 4)
  quantity_base            Decimal  @db.Decimal(14, 3)
  unit_price               Decimal  @db.Decimal(12, 2)
  discount                 Decimal? @default(0) @db.Decimal(12, 2)
  total_price              Decimal  @db.Decimal(14, 2)
  cost_at_sale             Decimal? @db.Decimal(12, 2)
}

model sale_payments {
  id             BigInt                 @id @default(autoincrement())
  sale_id        BigInt
  payment_method PaymentMethodWithOther
  amount         Decimal                @db.Decimal(14, 2)
  reference      String?                @db.VarChar(100)
  external_reference String?            @db.VarChar(100)
  status         String                 @default("confirmed") @db.VarChar(20)
  idempotency_key String?               @unique @db.VarChar(100)
  created_by     Int?
  confirmed_by   Int?
  created_at     DateTime               @default(now()) @db.Timestamp(0)
  confirmed_at   DateTime?              @db.Timestamp(0)
}

model sale_refunds {
  id              BigInt   @id @default(autoincrement())
  sale_id         BigInt
  refund_number   String   @unique @db.VarChar(40)
  total_amount    Decimal  @db.Decimal(14, 2)
  refund_method   String   @db.VarChar(30)
  status          String   @default("confirmed") @db.VarChar(20)
  reason          String   @db.VarChar(255)
  original_reference String? @db.VarChar(100)
  external_reference String? @db.VarChar(100)
  idempotency_key String   @unique @db.VarChar(100)
  request_hash    String   @db.Char(64)
  requested_by    Int?
  approved_by     Int?
  confirmed_by    Int?
  created_at      DateTime @default(now()) @db.Timestamp(0)
  confirmed_at    DateTime? @db.Timestamp(0)

  @@index([sale_id, created_at], map: "idx_sale_refund_sale_date")
  @@index([status, created_at], map: "idx_sale_refund_status_date")
}

model sale_refund_items {
  id                    BigInt   @id @default(autoincrement())
  refund_id             BigInt
  sale_item_id          BigInt
  product_id            Int
  product_name_snapshot String   @db.VarChar(150)
  quantity              Decimal  @db.Decimal(12, 3)
  quantity_base         Decimal  @db.Decimal(14, 3)
  disposition           String   @db.VarChar(20)
  refund_amount         Decimal  @db.Decimal(14, 2)
  created_at            DateTime @default(now()) @db.Timestamp(0)

  @@index([refund_id], map: "idx_sale_refund_item_refund")
  @@index([sale_item_id], map: "idx_sale_refund_item_sale_item")
}

model expense_categories {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
}

model expenses {
  id             BigInt                @id @default(autoincrement())
  category_id    Int?
  title          String                @db.VarChar(200)
  amount         Decimal               @db.Decimal(14, 2)
  expense_date   DateTime              @db.Date
  payment_method ExpensePaymentMethod? @default(cash)
  reference      String?               @db.VarChar(100)
  notes          String?               @db.Text
  created_by     Int?
  created_at     DateTime              @default(now()) @db.Timestamp(0)

  @@index([expense_date], map: "idx_expense_date")
}

model cash_registers {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  is_active  Int?     @default(1) @db.TinyInt
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model cash_sessions {
  id              BigInt             @id @default(autoincrement())
  register_id     Int
  opened_by       Int
  closed_by       Int?
  opening_balance Decimal            @default(0) @db.Decimal(14, 2)
  closing_balance Decimal?           @db.Decimal(14, 2)
  expected_cash   Decimal?           @db.Decimal(14, 2)
  actual_cash     Decimal?           @db.Decimal(14, 2)
  difference      Decimal?           @db.Decimal(14, 2)
  status          CashSessionStatus? @default(open)
  review_status   String             @default("not_required") @db.VarChar(20)
  review_notes    String?            @db.Text
  reviewed_by     Int?
  reviewed_at     DateTime?          @db.Timestamp(0)
  close_idempotency_key String?      @unique @db.VarChar(100)
  close_request_hash String?         @db.Char(64)
  opened_at       DateTime           @default(now()) @db.Timestamp(0)
  closed_at       DateTime?          @db.Timestamp(0)
  notes           String?            @db.Text
}

model cash_movements {
  id             BigInt           @id @default(autoincrement())
  session_id     BigInt?
  movement_type  CashMovementType
  amount         Decimal          @db.Decimal(14, 2)
  reference_type String?          @db.VarChar(50)
  reference_id   BigInt?
  notes          String?          @db.Text
  created_by     Int?
  idempotency_key String?         @unique @db.VarChar(100)
  created_at     DateTime         @default(now()) @db.Timestamp(0)

  @@index([session_id, created_at], map: "idx_cash_movement_session_date")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)
  entity_id   BigInt?
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([user_id, created_at], map: "idx_audit_user_date")
}
